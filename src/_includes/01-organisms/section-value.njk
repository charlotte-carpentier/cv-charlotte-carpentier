{# ===========================================================
   @ORGANISMS - SECTION-VALUE
   - Value section: title + optional text, cards, table, note, list, links
   - Grid and spacing from HAT section-value
   - Table stacks below 768px (CSS), ARIA roles kept for assistive tech
=========================================================== #}

{% macro renderSectionValue(option) %}
  {% from "03-atoms/typography.njk" import renderTypography %}
  {% from "03-atoms/icon.njk" import renderIcon %}
  {% from "03-atoms/link.njk" import renderLink %}

  {% if not option.datas %}
    <span class="text-red-500">Error: No section-value configuration provided</span>
  {% else %}
    {# Find section by name #}
    {% set sectionData = null %}
    {% for section in option.datas %}
      {% if section.name == option.name %}
        {% set sectionData = section %}
      {% endif %}
    {% endfor %}

    {% if not sectionData %}
      <span class="text-red-500">Section-value not found: {{ option.name }}</span>
    {% else %}
      <section class="section-value w-full spacing-section-fluid-y px-[var(--grid-margin-mobile)] break-words">
        <div class="w-full max-w-[var(--grid-workzone-content)] mx-auto flex flex-col gap-6">

          {# Title #}
          <div class="mb-6">
            {{ renderTypography({ name: sectionData.title, datas: option.typographyDatas }) }}
          </div>

          {# Optional text #}
          {% if sectionData.text %}
            {{ renderTypography({ name: sectionData.text, datas: option.typographyDatas }) }}
          {% endif %}

          {# Optional cards #}
          {% for card in sectionData.cards %}
            <div class="value-card flex flex-col gap-4 bg-[var(--cc-white)] border-[3px] lg:border-4 border-[var(--cc-black)] p-6 lg:p-10 [&_a]:underline [&_a]:underline-offset-2">
              <div class="flex flex-col items-center gap-2 text-center">
                {{ renderIcon({ name: card.icon, datas: option.iconDatas, decorative: true }) }}
                {{ renderTypography({ name: card.title, datas: option.typographyDatas }) }}
              </div>
              {% for textName in card.texts %}
                {{ renderTypography({ name: textName, datas: option.typographyDatas }) }}
              {% endfor %}
            </div>
          {% endfor %}

          {# Optional table #}
          {% if sectionData.table %}
            {% set table = sectionData.table %}
            <table class="value-table w-full" role="table">
              <caption class="text-left mb-2">
                {{ renderTypography({ name: table.caption, datas: option.typographyDatas }) }}
              </caption>
              <thead role="rowgroup">
                <tr role="row">
                  {% for column in table.columns %}
                    <th scope="col" role="columnheader">{{ column }}</th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody role="rowgroup">
                {% for row in table.rows %}
                  <tr role="row">
                    {% for cell in row %}
                      {% if loop.first %}
                        <th scope="row" role="rowheader">{{ cell }}</th>
                      {% else %}
                        <td role="cell" data-label="{{ table.columns[loop.index0] }}">{{ cell }}</td>
                      {% endif %}
                    {% endfor %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% endif %}

          {# Optional note #}
          {% if sectionData.note %}
            {{ renderTypography({ name: sectionData.note, datas: option.typographyDatas }) }}
          {% endif %}

          {# Optional list #}
          {% if sectionData.list %}
            <ul class="value-list flex flex-col gap-6 [&_a]:underline [&_a]:underline-offset-2 [&_cite]:not-italic" role="list">
              {% for item in sectionData.list %}
                <li id="{{ item.id }}">
                  {{ renderTypography({ name: item.text, datas: option.typographyDatas }) }}
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          {# Optional links #}
          {% if sectionData.links %}
            <div class="mt-4 flex flex-wrap gap-4">
              {% for linkName in sectionData.links %}
                {{ renderLink({ name: linkName, datas: option.linkDatas }) }}
              {% endfor %}
            </div>
          {% endif %}

        </div>
      </section>
    {% endif %}
  {% endif %}
{% endmacro %}